generator client {
  provider = "prisma-client"
  output   = "../generated/"
}

datasource db {
  provider = "postgresql"
}

// Enums

/// Lifecycle of a group buy as a whole.
enum GroupBuyStatus {
  /// Accepting new claims.
  OPEN
  /// All slots confirmed, no conflicts — claims are locked in.
  CLAIMED
  /// Frozen by an administrator. No mutations allowed by anyone.
  LOCKED
  /// Organiser has placed the order with the proxy service.
  /// Kit payment stage can now be opened on claims.
  PURCHASED
  /// Parcel is at the forwarding warehouse (e.g. Zenmarket / Sendico depot).
  /// Domestic shipping payment stage can now be opened (if applicable).
  AT_WAREHOUSE
  /// Parcel has been dispatched internationally.
  /// International shipping payment stage can now be opened.
  SHIPPED
  /// Parcel is with customs / import authorities.
  AT_CUSTOMS
  /// Customs cleared, duties assessed.
  /// Customs payment stage can now be opened.
  CLEARED_CUSTOMS
  /// Parcel is with the designated receiver.
  AT_RECEIVER
  /// All payments settled, kits distributed. Terminal state.
  COMPLETED
  /// Group buy was cancelled. Terminal state.
  CANCELLED
}

/// Per-claim status representing confirmation state and payment progress.
///
/// Flow:
///   0_PENDING → 1_CONFIRMED
///   1_CONFIRMED → 2_KIT_PAID
///   2_KIT_PAID → 3_DOMESTIC_SHIPPING_PAID (optional; skipped if seller covers domestic shipping)
///   2_KIT_PAID or 3_DOMESTIC_SHIPPING_PAID → 4_SHIPPING_PAID
///   4_SHIPPING_PAID → 5_CUSTOMS_PAID
///   5_CUSTOMS_PAID → 6_PAID_IN_FULL
///   CANCELLED available at any stage.
enum ClaimStatus {
  /// Slot claimed by member; awaiting organiser confirmation. (Stage 0)
  PENDING
  /// Organiser has confirmed the claim; no payment is due yet. (Stage 1)
  CONFIRMED
  /// Member has paid kit cost; organiser confirmed receipt. (Stage 2)
  KIT_PAID
  /// Member has paid domestic shipping (seller→forwarding warehouse); organiser confirmed. (Stage 3 — optional)
  DOMESTIC_SHIPPING_PAID
  /// Member has paid international shipping; organiser confirmed. (Stage 4)
  SHIPPING_PAID
  /// Member has paid customs/duties; organiser confirmed. (Stage 5)
  CUSTOMS_PAID
  /// All charges settled. Terminal success state. (Stage 6)
  PAID_IN_FULL
  /// Claim voided. Terminal failure state.
  CANCELLED
}

// Models

model Kit {
  id           String  @id @default(uuid())
  item_code    String  @unique
  release_date String?
  jpy_price    Int
  weight_grams Int?
  availability String
  stock_status String?
  product_name String

  wishlists    Wishlist[]
  groupBuyKits GroupBuyKit[]

  @@index([product_name, item_code])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  note      String?
  kitId     String
  createdAt DateTime @default(now())

  kit Kit @relation(fields: [kitId], references: [id])

  @@unique([userId, kitId])
  @@index([kitId])
  @@index([userId])
}

model GroupBuy {
  id         String  @id @default(uuid())
  /// Discord forum thread snowflake ID. One GB per thread.
  threadId   String  @unique
  guildId    String
  ownerId    String
  buyerId    String?
  receiverId String?

  status GroupBuyStatus @default(OPEN)

  // Financials (all JPY)
  // INR equivalents are computed at display time using inrConversionRate.

  /// Total deal price paid to the proxy service (kit cost + proxy fee + %).
  /// Proportioned to claims by (slot MSRP / total listing MSRP).
  costPrice Int?

  /// Domestic shipping cost in JPY — seller to forwarding warehouse
  /// (e.g. Zenmarket / Sendico domestic leg). Often ¥0 if seller covers it.
  /// Proportioned to claims by the same MSRP ratio as kit cost.
  domesticShippingCost Int?

  /// Total international shipping cost (forwarding warehouse → India) in JPY.
  /// Proportioned to claims by (slot weight / total listing weight).
  shippingCost Int?

  /// Total customs / import duties assessed in JPY.
  /// Proportioned to claims by (slot MSRP / total listing MSRP).
  customsCost Int?

  /// Sum of all GroupBuyKit.weight_grams for the full listing.
  totalWeight Int?

  /// Actual courier-weighed parcel weight (grams). Stored for display/records.
  /// The shipping cost split denominator is totalWeight (all slots), not this.
  shippingWeight Int?

  /// JPY → INR conversion rate for this GB. Set by buyer at purchase time.
  inrConversionRate Float?

  // Tracking
  shippingTrackingNumber String?
  shippingTrackingUrl    String?
  customsTrackingUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kits   GroupBuyKit[]
  claims GroupBuyClaim[]

  @@index([ownerId])
  @@index([buyerId])
  @@index([guildId])
}

model GroupBuyKit {
  id           String @id @default(uuid())
  groupBuyId   String
  kitId        String
  weight_grams Int
  slotNumber   Int

  groupBuy GroupBuy @relation(fields: [groupBuyId], references: [id])
  kit      Kit      @relation(fields: [kitId], references: [id])

  claims GroupBuyClaim[]

  @@index([groupBuyId, kitId])
  @@index([groupBuyId])
  @@index([kitId])
}

model GroupBuyClaim {
  id            String      @id @default(uuid())
  groupBuyId    String
  groupBuyKitId String
  userId        String
  status        ClaimStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Calculated cost splits (all JPY)
  // Denominator = ALL slots in the listing (proxy-buy model).
  // Recomputed across all active claims on every financial mutation.

  /// Share of costPrice. Formula: (slot.jpy_price / total listing MSRP) × costPrice
  calculatedKitCost Int?

  /// Share of domesticShippingCost (if set). Same MSRP proportion as kit cost.
  calculatedDomesticShippingCost Int?

  /// Share of shippingCost. Formula: (slot.weight_grams / total listing weight) × shippingCost
  calculatedShippingCost Int?

  /// Share of customsCost. Same MSRP proportion as kit cost.
  calculatedCustomsCost Int?

  paymentEvents ClaimPaymentEvent[]

  groupBuy    GroupBuy    @relation(fields: [groupBuyId], references: [id])
  groupBuyKit GroupBuyKit @relation(fields: [groupBuyKitId], references: [id])

  @@index([groupBuyId])
  @@index([userId])
  @@index([groupBuyKitId])
}

/// Which payment stage a ClaimPaymentEvent pertains to.
enum PaymentStage {
  KIT
  DOMESTIC_SHIPPING
  SHIPPING
  CUSTOMS
}

model ClaimPaymentEvent {
  id      String @id @default(uuid())
  claimId String

  stage PaymentStage

  /// "REPORTED" = member says they've paid.
  /// "CONFIRMED" = organiser verified receipt.
  /// "REJECTED"  = organiser rejected; member must re-report.
  action String

  actorId String
  note    String?

  createdAt DateTime @default(now())

  claim GroupBuyClaim @relation(fields: [claimId], references: [id])

  @@index([claimId])
  @@index([claimId, stage])
}
