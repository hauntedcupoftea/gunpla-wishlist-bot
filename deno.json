{
  "name": "haro",
  "version": "2.0.0",
  "description": "Gunpla group-buy Discord bot with REST API",
  "exports": "./src/index.ts",
  "nodeModulesDir": "auto",
  "imports": {
    "@libsql/client": "npm:@libsql/client@^0.17.0",
    "@prisma/adapter-libsql": "npm:@prisma/adapter-libsql@^7.5.0",
    "@prisma/client": "npm:@prisma/client@^7.5.0",
    "@prisma/config": "npm:@prisma/config@^7.5.0",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.5.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "pg": "npm:pg@^8.20.0",
    "axios": "npm:axios@^1.13.6",
    "cli-progress": "npm:cli-progress@^3.12.0",
    "discord.js": "npm:discord.js@^14.25.1",
    "dotenv": "npm:dotenv@^17.3.1",
    "htmlparser2": "npm:htmlparser2@^10.1.0",
    "@types/cli-progress": "npm:@types/cli-progress@^3.11.6",
    "@types/node": "npm:@types/node@^25.5.0",
    "prisma": "npm:prisma@^7.5.0",
    "elysia": "npm:elysia@^1.4.27",
    "@elysiajs/swagger": "npm:@elysiajs/swagger@^1.3.1"
  },
  "tasks": {
    "dev": "deno run --watch --env -A src/index.ts",
    "start": "deno run --env -A src/index.ts",
    "scrape": "deno run --env -A scripts/scrape-hlj.ts",
    "db:generate": "deno run --env -A npm:prisma generate",
    "db:push": "deno run --env -A npm:prisma db push",
    "db:seed": "deno run --env -A ./prisma/seed.ts",
    "db:migrate:dev": "deno run --env -A npm:prisma migrate dev",
    "db:migrate:deploy": "deno run --env -A npm:prisma migrate deploy",
    "db:sync": "diff prisma/schema.sqlite.prisma prisma/schema.postgresql.prisma | grep -v '^[0-9]' | grep -v 'provider'",
    "test:setup": "DB_PROVIDER=sqlite DATABASE_URL=file:prisma/test.db deno run -A npm:prisma db push --force-reset",
    "test": "deno task test:setup && TEST_DATABASE_URL=file:prisma/test.db deno test -A tests/",
    "test:unit": "deno test -A tests/lib/ tests/bot/",
    "test:service": "deno task test:setup && TEST_DATABASE_URL=file:prisma/test.db deno test -A tests/services/",
    "test:watch": "deno task test:setup && TEST_DATABASE_URL=file:prisma/test.db deno test -A --watch tests/"
  }
}
