{
  "name": "haro",
  "version": "2.0.0",
  "description": "Gunpla group-buy Discord bot with REST API",
  "exports": "./src/index.ts",
  "nodeModulesDir": "auto",
  "imports": {
    "@libsql/client": "npm:@libsql/client@^0.17.0",
    "@prisma/adapter-libsql": "npm:@prisma/adapter-libsql@^7.4.1",
    "@prisma/client": "npm:@prisma/client@^7.4.1",
    "@prisma/config": "npm:@prisma/config@^7.4.1",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@^7.4.1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "pg": "npm:pg@^8.11.0",
    "axios": "npm:axios@^1.13.5",
    "cli-progress": "npm:cli-progress@^3.12.0",
    "discord.js": "npm:discord.js@^14.25.1",
    "dotenv": "npm:dotenv@^17.3.1",
    "htmlparser2": "npm:htmlparser2@^10.1.0",
    "@types/cli-progress": "npm:@types/cli-progress@^3.11.6",
    "@types/node": "npm:@types/node@^25.3.0",
    "prisma": "npm:prisma@^7.4.1",
    "elysia": "npm:elysia@^1.2.25",
    "@elysiajs/swagger": "npm:@elysiajs/swagger@^1.2.2"
  },
  "tasks": {
    "dev": "deno run --watch --env -A src/index.ts",
    "start": "deno run --env -A src/index.ts",
    "scrape": "deno run --env -A src/commands/util/scrape-hlj.ts",
    "db:generate": "deno run --env -A npm:prisma generate",
    "db:push": "deno run --env -A npm:prisma db push",
    "db:seed": "deno run --env -A ./prisma/seed.ts",
    "db:migrate:dev": "deno run --env -A npm:prisma migrate dev",
    "db:migrate:deploy": "deno run --env -A npm:prisma migrate deploy",
    "db:sync": "diff prisma/schema.sqlite.prisma prisma/schema.postgresql.prisma | grep -v '^[0-9]' | grep -v 'provider'"
  }
}
